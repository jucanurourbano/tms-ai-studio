# === Aplicación ===
APP_NAME=TMS AI Studio
APP_ENV=development
API_V1_PREFIX=/api/v1

# === Anthropic / Claude ===
# Dejar VACÍA en desarrollo y tests: siempre se usan mocks (ver CLAUDE.md).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT=180
CLAUDE_PRICE_INPUT_PER_MTOK=3
CLAUDE_PRICE_OUTPUT_PER_MTOK=15

# === Control de gasto: libro mayor de llamadas y freno duro ===
# Son TRES números y solo DOS frenan. No hay bandera para apagar el freno: una
# bandera para apagarlo es la bandera que alguien deja apagada. Quien quiera
# trabajar sin freno pone un techo alto, y queda escrito aquí.
#
# El freno del JOB es el que más veces va a actuar: un techo mensual de 100 no
# impide que UNA corrida se coma el mes en una tarde. Cuando frene, el mensaje
# dice cuánto llevaba gastado el job y cuánto pedía la llamada que lo cruzó, para
# poder subirlo a conciencia y no a ciegas.
LLM_JOB_CAP_USD=5.0
LLM_MONTHLY_CAP_USD=100.0
# NO bloquea: se reporta. El gasto real debe quedar en 25-30 USD/mes; los 100 son
# techo de seguridad, y toda cifra se compara contra 30, nunca contra 100.
LLM_MONTHLY_TARGET_USD=30.0

# Mes de CALENDARIO en esta zona, no la del servidor: un contenedor en UTC rueda
# de mes a las 19:00 de Lima y partiría el gasto de un día entre dos meses.
# Residual: el periodo de facturación de Anthropic puede no ser el mes
# calendario, así que al conciliar contra la consola puede haber hasta un día de
# diferencia.
LLM_BUDGET_TZ=America/Lima

# Dimensionan el MARGEN con el que se comprueba el tope (no son límites
# aplicados): con concurrencia hay varias llamadas en vuelo que leen "por debajo
# del tope" y lo cruzan juntas, así que se niega cuando gastado + margen > tope.
# El precio es un pedazo de techo inutilizable (~3,4% del mes), declarado a
# cambio de que el tope duro no se cruce nunca. Hoy NADA acota la entrada de
# CRITIQUE: estos 100 000 son un supuesto auditable, no un techo aplicado.
LLM_MAX_INPUT_TOKENS_ASSUMED=100000
LLM_MAX_OUTPUT_TOKENS_ASSUMED=8192
LLM_BUDGET_HEADROOM_CALLS=8
LLM_JOB_HEADROOM_CALLS=3

# Tarifas de caché relativas a la de entrada. Hoy el caching no está activado en
# ninguna parte, así que los contadores vienen en 0 y la fórmula se reduce byte a
# byte a la de siempre. Están escritas para que activar `cache_control` mañana no
# haga que el tope empiece a mentir en silencio.
LLM_CACHE_READ_FACTOR=0.10
LLM_CACHE_WRITE_FACTOR=1.25

# === Infraestructura (contenedores docker-compose) ===
DATABASE_URL=postgresql+asyncpg://tms:tms_dev_password@localhost:5432/tms_ai_studio
REDIS_URL=redis://localhost:6379/0

# === Agente Scrum ===
SCRUM_SPRINT_CAPACITY=20
SCRUM_COVERAGE_THRESHOLD=1.0

# === Integración ClickUp (cuenta COMPARTIDA — guard fail-closed) ===
# Dejar VACÍO desactiva toda escritura (fail-closed). El agente SOLO opera dentro
# del espacio de Sistemas: la allowlist de listas es obligatoria para escribir.
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
CLICKUP_SPACE_ID=
CLICKUP_FOLDER_ID=
CLICKUP_ALLOWED_LIST_IDS=[]
CLICKUP_DRY_RUN=true

# === Agente QA, Modo C: exploración de una URL viva (fail-closed en 5 capas) ===
# Dejar DESACTIVADO desactiva toda exploración. El cliente NUNCA manda una URL:
# manda un alias declarado aquí, y sin allowlist de hosts no se navega a ninguna
# parte. `readonly_verified: true` es obligatorio (cuenta de SOLO LECTURA en la
# aplicación explorada). `data_class` solo puede ser "sintetico" si el host es
# local; cualquier host no local es "real", sin excepción.
QA_EXPLORE_ENABLED=false
QA_EXPLORE_TARGETS={}
QA_EXPLORE_ALLOWED_HOSTS=[]
# Ejemplo de un destino local para pruebas de punta a punta:
#   QA_EXPLORE_TARGETS={"dev-local": {"url": "http://localhost:3000/", "readonly_verified": true, "data_class": "sintetico"}}
#   QA_EXPLORE_ALLOWED_HOSTS=["localhost"]
# Radio de acción (enteros POSITIVOS: 0 es inválido, no significa "sin límite").
QA_EXPLORE_MAX_PAGES=50
QA_EXPLORE_MAX_DEPTH=3
QA_EXPLORE_TIMEOUT_MS=15000
QA_EXPLORE_TOTAL_BUDGET_S=300
QA_EXPLORE_MAX_CLICKS_PER_PAGE=8

# === Autenticación (JWT) ===
# Genera un secret fuerte, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# En PRODUCCIÓN debe ser único, secreto y rotarse periódicamente.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# === CORS (desarrollo: abierto) ===
CORS_ORIGINS=["*"]
